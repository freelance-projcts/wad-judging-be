# Database
# DATABASE_URL: used by the running app (Prisma Client) - point this at a
# pooled connection string in production (e.g. Neon's "-pooler" host).
DATABASE_URL="postgresql://wad_user:wad_password@localhost:5432/wad_judging?schema=public"
# DIRECT_URL: used only by Prisma CLI commands (migrate/db push/introspect).
# In local dev, same as DATABASE_URL (there's no pooler). In production with
# Neon, use the *unpooled* connection string here - schema migrations should
# not run through a transaction pooler.
DIRECT_URL="postgresql://wad_user:wad_password@localhost:5432/wad_judging?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret-in-production"
# Session/cookie lifetime - keep in sync with SESSION_MAX_AGE_SECONDS in src/lib/auth.ts
JWT_EXPIRES_IN="4h"

# Storage: "local" for dev, "s3" for production (S3-compatible object storage)
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="public/uploads"
LOCAL_UPLOAD_PUBLIC_PATH="/uploads"

# S3-compatible storage (only required when STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""

# App
NODE_ENV="development"

# CORS: comma-separated list of origins allowed to call the API cross-origin
# (in addition to same-origin requests, which need no CORS). Defaults to
# localhost:3000 + the deployed frontend if unset - see src/middleware.ts.
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://wadtestfe.netlify.app"
